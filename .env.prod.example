# TLS example on the host. Compose overrides API DB/broker and certificate paths.
HTTP_PORT=8443
DEBUG=false
POSTGRES_DB=http_api_template_prod
POSTGRES_USER=template_prod
POSTGRES_PASSWORD=replace-with-production-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
KAFKA_BROKER=localhost:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC=dummy-events-prod
KAFKA_GROUP_ID=dummy-service-prod
JWT_SECRET=replace-with-production-jwt-secret
SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key
