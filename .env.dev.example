# Development host settings; Compose overrides DB/broker addresses inside API.
HTTP_PORT=8081
DEBUG=true
POSTGRES_DB=http_api_template_dev
POSTGRES_USER=template_dev
POSTGRES_PASSWORD=replace-with-development-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
KAFKA_BROKER=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC=dummy-events-dev
KAFKA_GROUP_ID=dummy-service-dev
JWT_SECRET=replace-with-development-jwt-secret
SSL_CERT_PATH=
SSL_KEY_PATH=
